% Persian LaTeX Kit -- reusable, course-independent design system
% License status: reserved to the repository owner until one is selected.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{persian-kit}[2026/10/21 v1.2 Reusable Persian document components]
% Define metadata before \begin{document}; this package uses values only when rendering title.
% XePersian must be loaded after all other \RequirePackage commands.
\RequirePackage[a4paper,top=22mm,bottom=23mm,left=23mm,right=23mm,headheight=26pt]{geometry}
\RequirePackage[table]{xcolor}
\RequirePackage{array,tabularx,booktabs,multirow}
\RequirePackage{graphicx}
\RequirePackage{float}

\RequirePackage{titlesec}
\RequirePackage[most]{tcolorbox}
\RequirePackage{amsmath,amssymb}
\RequirePackage{xepersian}

% Compatibility with TeX Live 2026 array/bidi table handling.
% Without PDF tagging, some bidi releases reference an undefined hook in tabularx.
% Keep this harmless fallback until the upstream packages provide it.
\providecommand\UseMathForPositioningText{}

% ---- Fonts: Vazirmatn is required for Persian text and digits. ----
% Install the Regular and Bold fonts on the machine; do not commit font files.
% Fail loudly rather than silently changing the appearance of the PDF.
\IfFontExistsTF{Vazirmatn}{%
  \settextfont[Scale=1.05]{Vazirmatn}%
  \settextdigitfont[Scale=1.05]{Vazirmatn}%
  \setmathdigitfont[Scale=1.05]{Vazirmatn}%
}{%
  \PackageError{persian-kit}{Required font Vazirmatn not found}%
    {Install Vazirmatn Regular and Bold system-wide, restart the editor, and compile with XeLaTeX.}%
}
\IfFontExistsTF{Times New Roman}{%
  \setlatintextfont{Times New Roman}%
}{%
  \setlatintextfont{Liberation Serif}%
}
% Font digits follow the selected Persian typeface.

% ---- Theme palette (change these hex codes to recolor the whole project). ----
\definecolor{HWNavy}{HTML}{17324F}
\definecolor{HWBlue}{HTML}{216EA0}
\definecolor{HWTeal}{HTML}{087D84}
\definecolor{HWLight}{HTML}{EAF4F8}
\definecolor{HWStripe}{HTML}{F2F7FA}
\definecolor{HWLine}{HTML}{D1E3EB}
\definecolor{HWMuted}{HTML}{64748B}
\definecolor{HWWhite}{HTML}{FFFFFF}

% ---- Paragraphs and section hierarchy (single central control). ----
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}
\linespread{1.12}
\titleformat{\section}[hang]{\Large\bfseries\color{HWNavy}}{\thesection.}{0.6em}{}
\titlespacing*{\section}{0pt}{19pt}{9pt}
\titleformat{\subsection}[hang]{\large\bfseries\color{HWBlue}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{13pt}{6pt}
\titleformat{\subsubsection}[hang]{\normalsize\bfseries\color{HWTeal}}{}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{9pt}{4pt}

% ---- Stable Persian page numbering; avoid incompatible header packages. ----
\pagestyle{plain}

% ---- Reusable inline helpers. ----
% For Latin words with parentheses inside Persian text: \EN{Resource}
\newcommand{\EN}[1]{\lr{(#1)}}
\newcommand{\Term}[2]{\textbf{#1} \EN{#2}}
\newcommand{\SmallNote}[1]{{\small\color{HWMuted}#1}}

% ---- Assignment-specific layout. Call in main.tex after metadata, in document. ----
\newcommand{\HWActivateAssignmentLayout}{%
  % Intentionally use XePersian-aware built-in page style to avoid bidi
  % warnings in custom header/footer output routines.
  \pagestyle{plain}% Persian page number at bottom of every page.
}

% ---- Reusable title and metadata; no course-specific data in the library. ----
\newcommand{\MakeHomeworkTitle}{%
  \thispagestyle{plain}%
  \begin{center}
    {\small\color{HWMuted}به نام خدا}\\[8pt]
    {\LARGE\bfseries\color{HWNavy}\HWAssignment}\\[5pt]
    {\normalsize\color{HWTeal}\HWInstitution}
  \end{center}
  \vspace{3pt}
  \begin{tcolorbox}[enhanced,colback=HWLight,colframe=HWLine,
    boxrule=0.6pt,arc=1.3mm,left=3mm,right=3mm,top=2.4mm,bottom=2.4mm]
    \textbf{نام درس:} \HWCourse\hfill\textbf{استاد:} \HWProfessor\par
    \textbf{دانشجو:} \HWStudentName\hfill\textbf{شماره دانشجویی:} \HWStudentID\par
    \textbf{نیمسال:} \HWTerm\hfill\textbf{تاریخ تحویل:} \HWDeadline
  \end{tcolorbox}
  \vspace{5pt}
}

% ---- Consistent, automatic question numbering and subsection hierarchy. ----
% \HWQuestion or \HWQuestion[عنوان کوتاه]
% \HWPart{الف} or \HWPart{الف}[عنوان]
\NewDocumentCommand{\HWQuestion}{o}{%
  \refstepcounter{section}%
  \section*{سؤال \thesection\IfNoValueF{#1}{\quad {\normalfont\normalsize\color{HWMuted}#1}}}%
}
\NewDocumentCommand{\HWPart}{m o}{%
  \subsection*{قسمت #1\IfNoValueF{#2}{\quad {\normalfont\normalsize\color{HWMuted}#2}}}%
}
\NewDocumentCommand{\HWSubpart}{m}{%
  \subsubsection*{#1}%
}

% ---- Reusable semantic boxes. ----
\newtcolorbox{HWTip}[1][]{enhanced,breakable,boxrule=0.55pt,colback=HWLight,
  colframe=HWLine,arc=1.5mm,left=3mm,right=3mm,top=2mm,bottom=2mm,
  borderline west={2.5pt}{0pt}{HWTeal},#1}
\newtcolorbox{HWWarning}[1][]{enhanced,breakable,boxrule=0.55pt,colback=white,
  colframe=HWLine,arc=1.5mm,left=3mm,right=3mm,top=2mm,bottom=2mm,
  borderline west={2.5pt}{0pt}{HWBlue},#1}

% ---- Reusable shaded table formatting (uniform style for every table). ----
\newcolumntype{Y}{>{\raggedleft\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\newcommand{\HWTableStart}{\rowcolors{2}{HWStripe}{white}\renewcommand{\arraystretch}{1.35}}
\newcommand{\HWTableEnd}{\rowcolors{2}{}{}}
\newcommand{\HWTableHead}[1]{\color{white}\bfseries #1}

% ---- Figures drawn on tablet: PDF or PNG, centered with caption. ----
\newcommand{\HWFigure}[3][0.85]{%
  \begin{figure}[htbp]\centering
    \includegraphics[width=#1\linewidth]{#2}\\[3pt]
    {\small\color{HWMuted}#3}
  \end{figure}%
}


% ---- Optional scoped, width-adaptive table wrapper. ----
\NewDocumentEnvironment{HWTable}{m +b}{%
  \begingroup
  \renewcommand{\arraystretch}{1.35}%
  \setlength{\tabcolsep}{4pt}%
  \rowcolors{2}{HWStripe}{white}%
  \begin{tabularx}{\dimexpr\linewidth-5pt\relax}{#1}
  #2
  \end{tabularx}%
  \endgroup
}


% ---- Course-neutral defaults; override in config/metadata.tex. ----
\providecommand{\HWStudentName}{نام دانشجو}
\providecommand{\HWStudentID}{شماره دانشجویی}
\providecommand{\HWCourse}{عنوان درس}
\providecommand{\HWProfessor}{نام استاد}
\providecommand{\HWTerm}{نیمسال تحصیلی}
\providecommand{\HWAssignment}{عنوان تمرین}
\providecommand{\HWInstitution}{دانشگاه / دانشکده}
\providecommand{\HWDeadline}{تاریخ تحویل}
